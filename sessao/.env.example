# Copie este arquivo para .env.
# Obrigatório: as chaves do TMDB (https://www.themoviedb.org/settings/api).
VITE_TMDB_READ_TOKEN=
VITE_TMDB_API_KEY=

# Opcional: só para apontar o app para outro projeto Firebase. Sem estas variáveis
# vale a configuração pública embutida em src/firebase.js.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
