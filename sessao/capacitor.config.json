{
  "appId": "com.natanaelneves.sessao",
  "appName": "Sessão",
  "webDir": "dist",
  "android": {
    "path": "capacitor-android"
  },
  "plugins": {
    "SystemBars": {
      "style": "DARK"
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com",
        "apple.com"
      ]
    }
  },
  "experimental": {
    "ios": {
      "spm": {
        "swiftToolsVersion": "6.1",
        "packageTraits": {
          "@capacitor-firebase/authentication": [
            "Google"
          ]
        }
      }
    }
  }
}
