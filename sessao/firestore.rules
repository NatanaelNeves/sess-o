rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers
    function isAuth() {
      return request.auth != null;
    }
    function isMember(coupleData) {
      return coupleData.uid1 == request.auth.uid || coupleData.uid2 == request.auth.uid;
    }
    function coupleData(coupleId) {
      return get(/databases/$(database)/documents/couples/$(coupleId)).data;
    }
    // funções de regra aceitam só uma expressão de retorno — nada de `if`
    function reviewOwnerName(coupleData) {
      return request.auth.uid == coupleData.uid1 ? coupleData.name1
           : request.auth.uid == coupleData.uid2 ? coupleData.name2
           : null;
    }
    function reviewPartnerName(coupleData) {
      return request.auth.uid == coupleData.uid1 ? coupleData.name2
           : request.auth.uid == coupleData.uid2 ? coupleData.name1
           : null;
    }
    // Cada um só escreve a própria crítica; as outras chaves de `reviews` ficam
    // como estavam. Os demais campos da memória podem mudar junto (o formulário
    // "Editar registro" regrava o documento inteiro).
    // `keys()` devolve uma lista: `union` só existe em conjuntos, por isso o toSet().
    function ownReviewUpdate(coupleData) {
      let owner = reviewOwnerName(coupleData);
      let partner = reviewPartnerName(coupleData);
      let oldReviews = resource.data.get("reviews", {});
      let newReviews = request.resource.data.get("reviews", {});
      return owner != null
        && newReviews.keys().toSet().hasOnly(oldReviews.keys().toSet().union([owner].toSet()))
        && newReviews.keys().hasAll(oldReviews.keys().removeAll([owner]))
        && (!newReviews.keys().hasAny([owner]) || newReviews[owner] != null)
        && (partner == null
          || newReviews.get(partner, null) == oldReviews.get(partner, null));
    }
    function isJoiningCouple(coupleId) {
      let code = resource.data.inviteCode;
      return resource.data.uid2 == null
        && request.resource.data.uid2 == request.auth.uid
        && request.resource.data.name2 is string
        && request.resource.data.name2.size() >= 1
        && request.resource.data.name2.size() <= 40
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["uid2", "name2"])
        && exists(/databases/$(database)/documents/inviteCodes/$(code))
        && get(/databases/$(database)/documents/inviteCodes/$(code)).data.coupleId == coupleId;
    }
    function isOwnProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name1", "name2", "since"])
        && (
          (resource.data.uid1 == request.auth.uid && request.resource.data.name2 == resource.data.name2)
          || (resource.data.uid2 == request.auth.uid && request.resource.data.name1 == resource.data.name1)
        );
    }
    // "Nossos streamings": qualquer um dos dois escolhe; só uma lista curta de IDs do TMDB
    function isStreamingsUpdate() {
      return isMember(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["streamings"])
        && request.resource.data.streamings is list
        && request.resource.data.streamings.size() <= 40;
    }
    function isLeavingCouple() {
      return resource.data.uid2 == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["uid2", "name2"])
        && !('uid2' in request.resource.data)
        && !('name2' in request.resource.data);
    }

    // Couples collection
    match /couples/{coupleId} {
      // Only the two members can read the couple document. Queries filtered by
      // uid1/uid2 continue to work without exposing other couples or invite codes.
      allow read: if isAuth() && isMember(resource.data);

      // Create: only the first user (uid1) can create their own couple
      allow create: if isAuth()
        && request.resource.data.uid1 == request.auth.uid
        && request.resource.data.uid2 == null
        && request.resource.data.name1 is string
        && request.resource.data.name1.size() >= 1
        && request.resource.data.name1.size() <= 40
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() >= 6
        && request.resource.data.inviteCode.size() <= 8;

      allow update: if isAuth() && (isOwnProfileUpdate() || isJoiningCouple(coupleId) || isLeavingCouple() || isStreamingsUpdate());

      // Delete: only uid1 can delete
      allow delete: if isAuth() && resource.data.uid1 == request.auth.uid;

      // Watched subcollection
      match /watched/{entryId} {
        allow read: if isAuth() && isMember(coupleData(coupleId));
        allow create: if isAuth() && isMember(coupleData(coupleId)) && (
          !('reviews' in request.resource.data)
          || request.resource.data.reviews.keys().hasOnly([reviewOwnerName(coupleData(coupleId))])
        );
        allow update: if isAuth() && isMember(coupleData(coupleId)) && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["reviews"])
          || ownReviewUpdate(coupleData(coupleId))
        );
        allow delete: if isAuth() && isMember(coupleData(coupleId));
      }

      // Watchlist subcollection
      match /watchlist/{entryId} {
        allow read, write: if isAuth() && isMember(coupleData(coupleId));
      }

      // Sugestões recusadas ("já vimos" / "não é pra nós") — o Lumi não repete
      match /sugestoes/{titleKey} {
        allow read, delete: if isAuth() && isMember(coupleData(coupleId));
        allow create, update: if isAuth() && isMember(coupleData(coupleId))
          && request.resource.data.veredito in ["ja_vimos", "nao_e_pra_nos"]
          && request.resource.data.por is string
          && request.resource.data.em is string;
      }

      // Álbum das sessões — uma foto por documento, guardada como data URL
      // porque o plano gratuito do Firebase não inclui o Storage.
      match /photos/{photoId} {
        allow read: if isAuth() && isMember(coupleData(coupleId));
        allow create, update: if isAuth() && isMember(coupleData(coupleId))
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 700000;
        allow delete: if isAuth() && isMember(coupleData(coupleId));
      }
    }

    // Invite codes live in a separate, minimal lookup document. A signed-in
    // user may fetch one exact code, but cannot list or enumerate invites.
    match /inviteCodes/{inviteCode} {
      allow get: if isAuth();
      allow list: if false;
      allow create: if isAuth()
        && inviteCode.size() >= 6
        && inviteCode.size() <= 8
        && request.resource.data.coupleId is string
        && request.resource.data.createdBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/couples/$(request.resource.data.coupleId)).data.uid1 == request.auth.uid
        && getAfter(/databases/$(database)/documents/couples/$(request.resource.data.coupleId)).data.inviteCode == inviteCode;
      allow update: if false;
      allow delete: if isAuth() && resource.data.createdBy == request.auth.uid;
    }
  }
}
