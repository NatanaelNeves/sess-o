<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>pt-BR</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>pt-BR</string>
	</array>
	<key>CFBundleDisplayName</key>
        <string>Sessão</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Login do Google: troque pelo REVERSED_CLIENT_ID do GoogleService-Info.plist (ver docs/PUBLICACAO-MOBILE.md) -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.SUBSTITUIR-PELO-REVERSED-CLIENT-ID</string>
			</array>
		</dict>
		<!-- links do próprio app: com.natanaelneves.sessao://acao/... (atalhos e notificações) -->
		<dict>
			<key>CFBundleURLName</key>
			<string>com.natanaelneves.sessao</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.natanaelneves.sessao</string>
			</array>
		</dict>
	</array>
	<!-- só HTTPS padrão: isento de declaração de exportação de criptografia -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- O álbum da sessão aceita foto tirada na hora ou da galeria (input de arquivo do WebView) -->
	<key>NSCameraUsageDescription</key>
	<string>O Sessão usa a câmera só quando você tira uma foto para o álbum de uma sessão.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>O Sessão abre suas fotos só quando você escolhe uma imagem para o álbum de uma sessão.</string>
	<!-- "Salvar imagem" na folha de compartilhamento (cartões e retrospectiva) -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>O Sessão salva na sua galeria os cartões e retrospectivas que você pedir para salvar.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
            <key>UISceneConfigurationName</key>
            <string>Default Configuration</string>
            <key>UISceneDelegateClassName</key>
            <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
            <key>UISceneStoryboardFile</key>
            <string>Main</string>
        </dict>
      </array>
    </dict>
	</dict>
	<!-- atalhos do ícone (toque longo); SceneDelegate.swift os transforma em links do app -->
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.natanaelneves.sessao.registrar</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Registrar sessão</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>o que vocês assistiram hoje?</string>
			<key>UIApplicationShortcutItemIconType</key>
			<string>UIApplicationShortcutIconTypeAdd</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.natanaelneves.sessao.querover</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Adicionar à lista a dois</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>pra uma próxima noite</string>
			<key>UIApplicationShortcutItemIconType</key>
			<string>UIApplicationShortcutIconTypeBookmark</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.natanaelneves.sessao.roleta</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>O que vamos ver hoje?</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>a roleta escolhe da lista</string>
			<key>UIApplicationShortcutItemIconType</key>
			<string>UIApplicationShortcutIconTypeShuffle</string>
		</dict>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
